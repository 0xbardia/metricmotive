# Copy to a local .env if you run outside this workspace.
# Do not commit secrets. The App Builder preview injects these for you.

# Optional. If unset, the app uses embedded PGLite.
DATABASE_URL=

# Optional. If unset, Motive Preflight and related advisory calls use heuristics.
# Never prefix these with VITE_ — they must stay server-only.
OFFCHAIN_AI_API_KEY=
OFFCHAIN_AI_BASE_URL=https://api.x.ai/v1
OFFCHAIN_AI_MODEL=grok-4.5
OFFCHAIN_AI_TIMEOUT_MS=20000

# Public app URL used in docs and WalletConnect metadata.
VITE_APP_URL=http://localhost:8080

# WalletConnect Cloud / Reown project id (32-char hex). Required for WalletConnect
# wallets. Injected wallets (MetaMask and similar) work without it.
# Get one at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Public GenLayer network. These are not secrets.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_CONTRACT_ADDRESS=0xe39e59f8Dd78E416D9EE074Ca3f899C7Eb56Fb2d
GENLAYER_NETWORK=Studionet

# Evidence and API bounds (documented defaults; code enforces LIMITS in domain.ts)
# MOTIVE/METRIC 2000 chars, 12 guardrails, evidence 8000 chars, 60 req/min mutating API.

# Wallet private keys are never stored here. Browser wallets sign writes.
# No custodial wallet. No silent fallback to a superseded contract address.

# Scripts only (hosted certification / SDK --onchain). NEVER prefix with VITE_.
# GENLAYER_PRIVATE_KEY=
# GENLAYER_ACCOUNT_PATH=/tmp/studio-account.json
